rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 순위표 기록: 누구나 볼 수 있고, 형식이 맞는 기록만 새로 추가할 수 있음. 수정은 불가.
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'level'])
        && request.resource.data.keys().hasAll(['name', 'score', 'level'])
        && request.resource.data.name is string
        && request.resource.data.name.matches("[A-Za-z][A-Za-z .'-]{1,23}")
        && request.resource.data.score is int
        && request.resource.data.score >= 10
        && request.resource.data.score <= 9999990
        && request.resource.data.score % 10 == 0
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 999
        && request.resource.data.score <= request.resource.data.level * 30000;
      // 연결 확인용으로 넣는 'Rules Test' 기록만 지울 수 있음
      allow delete: if resource.data.name == 'Rules Test';
    }
  }
}
